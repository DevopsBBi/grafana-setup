# Inventory of the monitoring stack. No secrets here (they go in secrets.env).
# Read by scripts/lib.sh as shell variables.

# ---- Application server (cloud VPS)
APP_HOST_NAME="ov-ab27bf"
APP_SSH_USER="devops"
APP_PUBLIC_IP="83.228.207.124"
APP_TS_IP="100.69.47.69"            # Tailscale address
APP_HOST_LABEL="vps-web"            # value of the "host" label on every log line and metric
APP_TS_NAME="vps"                 # machine name in the Tailscale console
APP_DB_NAME="Lasource-App"          # application database (PostgreSQL 14)

# ---- Monitoring server (office VM)
MON_HOST_NAME="n8nserver"
MON_SSH_USER="devops01"
MON_LAN_IP="192.168.15.14"
MON_LAN_CIDR="192.168.15.0/24"
MON_TS_IP="100.118.61.101"          # Tailscale address
MON_TS_NAME="local-vm"            # machine name in the Tailscale console

# ---- Services on the monitoring server
LOKI_PORT="3100"
PROM_PORT="9091"                    # Prometheus (Docker container below), remote-write receiver
PROM_CONTAINER="vps_prometheus"
LOKI_CONFIG_PATH="/etc/loki/config.yml"   # set by scripts/import.py from the live loki service
GRAFANA_PORT="3001"                 # Grafana installed with apt (the old Docker Grafana is on 3000)
DASHBOARD_NAME="dashboard.local"    # local address, published with mDNS (avahi)
DASHBOARD_UPSTREAM="http://127.0.0.1:3001"   # what dashboard.local shows (set by scripts/import.py from the live Nginx site)

# ---- Grafana objects (names are used by the dashboards; uids by the alert rules)
GRAFANA_FOLDER="Supervision Odoo"
DS_LOKI_NAME="loki"
DS_PROM_NAME="prometheus-2"
DS_PG_NAME="BBi"
DS_LOKI_UID=""                      # filled by scripts/import.py from the live Grafana
DS_PROM_UID=""
DS_PG_UID=""

# ---- Alloy -> PostgreSQL statistics
PG_MONITOR_USER="alloy_monitor"

# ---- Email alerts (Grafana -> Postfix on the application server -> recipients)
ALERT_EMAILS="devops01@brothersbusinessintelligence.com;dev-odoo@sofabi.eu"
ALERT_FROM_LOCAL="alertes"          # sender = alertes@<domain detected on the VPS>
