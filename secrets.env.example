# Copy this file to secrets.env on the server you rebuild, fill it in, then: chmod 600 secrets.env
# secrets.env is ignored by git. Never paste these values in a chat or a ticket.

PG_MONITOR_PASSWORD=""      # PostgreSQL role used by Alloy (see vps/postgres/monitoring-role.sql)
GRAFANA_ADMIN_PASSWORD=""   # Grafana "admin" password (set on rebuild; leave empty to keep the current one)
GRAFANA_PG_PASSWORD=""      # password of the read-only user behind the Grafana "BBi" data source
TS_AUTHKEY=""               # optional: Tailscale auth key for an unattended join (otherwise a login link is shown)
