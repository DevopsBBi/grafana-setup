# http://@@DASHBOARD_NAME@@ -> Grafana on this machine. Reachable from the office network only (see ufw rules).
map $http_upgrade $local_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name @@DASHBOARD_NAME@@;

    location / {
        proxy_pass @@DASHBOARD_UPSTREAM@@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana Live (websocket)
    location /api/live/ {
        proxy_pass @@DASHBOARD_UPSTREAM@@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $local_connection_upgrade;
        proxy_set_header Host $host;
    }
}
