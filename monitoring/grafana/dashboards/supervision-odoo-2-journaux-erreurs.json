    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs Odoo",
      "description": "Erreurs ERROR ou CRITICAL d'Odoo sur la période. Toute valeur au-dessus de 0 est rouge.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "datasource": "loki",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "loki",
          "expr": "sum(count_over_time({job=\"odoo\", level=~\"ERROR|CRITICAL\"} [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
